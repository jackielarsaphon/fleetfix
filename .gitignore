# ความลับ — ห้ามขึ้น git เด็ดขาด (รหัสผ่านฐานข้อมูล, กุญแจ API)
.env
.env.*
!.env.example
# ยกเว้นค่าที่ใช้ build ขึ้น Pages — มีแค่ URL กับ publishable key ที่เปิดเผยได้
!.env.production

# dependency / ผลลัพธ์การ build
node_modules/
dist/
dist-ssr/
.vite/

# ไฟล์ที่ Go build ออกมา และไฟล์รูปที่อัปโหลด
# ใช้ path เต็ม ไม่ใช่ชื่อ "server" เฉย ๆ ไม่งั้นจะไปตรงกับโฟลเดอร์ cmd/server ด้วย
/stores/server
/stores/server.exe
*.exe~
bin/
data/

# ไฟล์ชั่วคราวจากการทดสอบ
.probe/
.smoke/
.gotmp/
*.local

# ระบบปฏิบัติการ / เครื่องมือ
.DS_Store
Thumbs.db
