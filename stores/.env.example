# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้)

# connection string ของ Postgres บน Supabase
# เอาจาก Dashboard → Project Settings → Database → Connection string → URI
# แนะนำใช้แบบ Connection pooling (พอร์ต 6543) สำหรับเซิร์ฟเวอร์ที่ scale ได้
# ต้องแทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูลจริง
DATABASE_URL=postgresql://postgres.tqfhrmvteutkstbsseuq:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# host:port ที่ API จะ listen
ADDR=:8080

# origin ที่อนุญาตให้เรียกข้าม origin (คั่นด้วย ,) — ใส่ * เพื่ออนุญาตทุกที่
ALLOWED_ORIGINS=http://localhost:5173
